{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://amep.example/schemas/v0.2/approval.json",
 "title": "approval",
 "description": "ApprovalBinding (spec 5.10). Signed by role approver. The digest excludes t. Exactly one of effect_digest and effect_digests (an operation approval, v0.3).",
 "type": "object",
 "required": [
  "kind",
  "id",
  "presence"
 ],
 "properties": {
  "kind": {
   "const": "approval"
  },
  "id": {
   "$ref": "common.json#/$defs/ref"
  },
  "effect_digest": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "effect_digests": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "presence": {
   "enum": [
    "webauthn",
    "chat_user",
    "host_ui",
    "none"
   ]
  },
  "approver": {
   "type": "string"
  },
  "resource_version": {
   "type": "string"
  },
  "nbf": {
   "$ref": "common.json#/$defs/time"
  },
  "expiry": {
   "$ref": "common.json#/$defs/time"
  },
  "consumed": {
   "type": "boolean"
  },
  "findings": {
   "description": "For a principal's confirmation: the ids of the findings the principal was shown (spec 5.11, v0.3.3).",
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "common.json#/$defs/ref"
   }
  },
  "proof": {
   "$ref": "common.json#/$defs/proof"
  }
 },
 "patternProperties": {
  "^x-": {},
  "\\.": {}
 },
 "additionalProperties": false,
 "oneOf": [
  {
   "required": [
    "effect_digest"
   ]
  },
  {
   "required": [
    "effect_digests"
   ]
  }
 ]
}