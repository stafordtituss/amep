{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://amep.example/schemas/v0.2/keyset.json",
 "title": "keyset",
 "description": "Key set served at /.well-known/amep-keys.json (spec 12.4, 12.5).",
 "type": "object",
 "additionalProperties": {
  "type": "object",
  "required": [
   "kid",
   "alg",
   "x",
   "roles"
  ],
  "additionalProperties": false,
  "properties": {
   "kid": {
    "type": "string"
   },
   "alg": {
    "enum": [
     "Ed25519",
     "ES256"
    ]
   },
   "x": {
    "type": "string"
   },
   "roles": {
    "type": "array",
    "minItems": 1,
    "items": {
     "enum": [
      "issuer",
      "host",
      "observer",
      "approver"
     ]
    }
   },
   "nbf": {
    "$ref": "common.json#/$defs/time"
   },
   "exp": {
    "$ref": "common.json#/$defs/time"
   },
   "revoked": {
    "type": "boolean"
   }
  }
 }
}