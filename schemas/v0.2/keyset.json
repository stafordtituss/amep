{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://amep.example/schemas/v0.2/keyset.json",
 "title": "keyset",
 "description": "Key set served at /.well-known/amep-keys.json (spec 12.4, 12.5).",
 "type": "object",
 "additionalProperties": {
  "type": "object",
  "required": [
   "kid",
   "alg",
   "x",
   "roles"
  ],
  "additionalProperties": false,
  "properties": {
   "kid": {
    "type": "string"
   },
   "alg": {
    "enum": [
     "Ed25519",
     "ES256"
    ]
   },
   "x": {
    "type": "string"
   },
   "operator": {
    "type": "string",
    "minLength": 1,
    "description": "Identifier of the organisation that controls this key (spec 12.5). Keys with the same operator are one party for observer independence (I10)."
   },
   "clock_skew": {
    "type": "number",
    "minimum": 0,
    "description": "The most, in seconds, by which the times this key's signer reports may differ from true time (spec 5.12.2, v0.3.4). Verifiers refuse a value above 3600 as malformed."
   },
   "roles": {
    "type": "array",
    "minItems": 1,
    "items": {
     "enum": [
      "issuer",
      "host",
      "observer",
      "approver"
     ]
    }
   },
   "nbf": {
    "$ref": "common.json#/$defs/time"
   },
   "exp": {
    "$ref": "common.json#/$defs/time"
   },
   "revoked": {
    "type": "boolean"
   }
  }
 }
}